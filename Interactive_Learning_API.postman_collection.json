							"path": [
								"sessions",
								"{{session_id}}",
								"speak"
							]
						},
						"description": "Send an utterance with a common age error. Ahmad reformulates implicitly (Recast)."
					},
					"response": []
				},
				{
					"name": "4.3 Student Speaks (Short / Unclear -> Clarification)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
