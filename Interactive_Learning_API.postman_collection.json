							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"text\": \"I have 16 years and I like English very much.\",\n    \"confidence\": 0.95\n}"
						},
						"url": {
							"raw": "{{base_url}}/sessions/{{session_id}}/speak",
							"host": [
								"{{base_url}}"
