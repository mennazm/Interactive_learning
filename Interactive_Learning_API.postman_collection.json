						"url": {
							"raw": "{{base_url}}/scenarios",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"scenarios"
							]
						},
						"description": "Fetch the 8 B1 speaking scenarios with topics, vocabulary, and communicative functions."
					},
					"response": []
				},
				{
					"name": "2.2 Get Scenario Details",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [
							{
