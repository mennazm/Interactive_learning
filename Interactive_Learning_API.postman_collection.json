							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"text\": \"Hi\",\n    \"confidence\": 0.90\n}"
						},
						"url": {
							"raw": "{{base_url}}/sessions/{{session_id}}/speak",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"sessions",
